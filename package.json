{
  "name": "priori",
  "version": "0.1.0",
  "private": true,
  "description": "Priori monorepo — engine, API, and web UI",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @priori/engine",
    "typecheck": "npm run typecheck -w @priori/engine",
    "rank": "npm run rank -w @priori/engine",
    "test": "npm run test -w @priori/engine",
    "test:coverage": "npm run test:coverage -w @priori/engine",
    "dev:api": "npm run dev -w @priori/api",
    "dev:backend": "npm run dev -w @priori/api",
    "dev:web": "npm run dev -w @priori/web"
  }
}
